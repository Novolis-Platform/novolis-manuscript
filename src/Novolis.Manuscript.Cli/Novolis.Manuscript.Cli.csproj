<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>novolis-manuscript</ToolCommandName>
    <PackageId>Novolis.Manuscript.Cli</PackageId>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.Manuscript.Cli</RootNamespace>
    <Description>CLI for manuscript book surgery, audiobook generation, print, metrics, and editorial lint.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Novolis.Manuscript\Novolis.Manuscript.csproj" />
    <ProjectReference Include="..\Novolis.Manuscript.IO\Novolis.Manuscript.IO.csproj" />
    <ProjectReference Include="..\Novolis.Manuscript.Export.Audio\Novolis.Manuscript.Export.Audio.csproj" />
    <ProjectReference Include="..\Novolis.Manuscript.Export.Pdf\Novolis.Manuscript.Export.Pdf.csproj" />
    <ProjectReference Include="..\Novolis.Manuscript.Export.Markdown\Novolis.Manuscript.Export.Markdown.csproj" />
    <ProjectReference Include="..\Novolis.Manuscript.Metrics\Novolis.Manuscript.Metrics.csproj" />
    <ProjectReference Include="..\Novolis.Manuscript.Editorial\Novolis.Manuscript.Editorial.csproj" />
    <PackageReference Include="Novolis.Audio.Voice.EdgeTts" />
    <PackageReference Include="Novolis.IO.Paths" />
  </ItemGroup>
</Project>
