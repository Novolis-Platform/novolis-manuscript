<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Manuscript.Export.Pdf</PackageId>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.Manuscript.Export.Pdf</RootNamespace>
    <Description>Manuscript PDF export via Novolis.Documents + Documents.Skia with Markdown/HTML/TXT companions.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <LibraryReference Include="Novolis.Documents" />
    <LibraryReference Include="Novolis.Documents.Layout" />
    <LibraryReference Include="Novolis.Documents.Skia" />
    <LibraryReference Include="Novolis.Markup.Markdown" />
    <LibraryReference Include="Novolis.Markup.Markdown.Documents" />
    <LibraryReference Include="Novolis.Math.Measure" />
    <!-- Explicit: ProjectReference mode substitutes Novolis.Documents.Skia with a sibling ProjectReference,
         which does not carry its transitive SkiaSharp package dependencies through the NuGet restore graph. -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" />
    <ProjectReference Include="..\Novolis.Manuscript\Novolis.Manuscript.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Novolis.Manuscript.Unit" />
  </ItemGroup>
</Project>
