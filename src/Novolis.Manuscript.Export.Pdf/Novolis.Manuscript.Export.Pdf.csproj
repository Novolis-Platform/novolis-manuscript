<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Manuscript.Export.Pdf</PackageId>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.Manuscript.Export.Pdf</RootNamespace>
    <Description>Manuscript PDF export via QuestPDF with Markdown/HTML/TXT companions.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="Novolis.Markup.Markdown.Rendering" />
    <ProjectReference Include="..\Novolis.Manuscript\Novolis.Manuscript.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Novolis.Manuscript.Unit" />
  </ItemGroup>
</Project>
